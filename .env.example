# Vorlage für .env (cp .env.example .env). Geheimnisse gehören NICHT hierher, sondern nach ./secrets/.

# Admin-Oberfläche (Origin, ohne Pfad und ohne Schrägstrich am Ende). Jeder andere Host bekommt
# die Statusseiten.
UWUSTATUS_PUBLIC_URL=https://status-admin.example.com

# OIDC (z. B. UwUAuth). Redirect-URI beim Anbieter: ${UWUSTATUS_PUBLIC_URL}/api/auth/callback
# Leer = ohne OIDC (dann nur der lokale Admin).
UWUSTATUS_OIDC_ISSUER=https://auth.example.com
UWUSTATUS_OIDC_CLIENT_ID=uwustatus
# Optional: Server-zu-Server-Aufrufe (Discovery, Token, JWKS) an diese Origin statt an den Issuer.
#UWUSTATUS_OIDC_BACKCHANNEL_URL=http://auth.internal.example:8080

# Wer per OIDC darf: Gruppe im groups-Claim und/oder sub-Werte (Komma-getrennt). Beides leer = niemand.
UWUSTATUS_ALLOWED_GROUP=uwustatus-admins
UWUSTATUS_ALLOWED_SUBJECTS=

# Lokaler Admin (Notzugang, falls UwUAuth ausfällt). Passwort (mind. 12 Zeichen) oder Argon2-Hash
# in secrets/admin_password, TOTP-Secret optional in secrets/admin_totp
# (erzeugen: docker compose run --rm uwustatus totp-secret). Leere Datei = aus.
UWUSTATUS_ADMIN_USER=admin
